[0.022, "o", "================================================================\r\n  Kata Containers + BlueField-3 DPU Cold-Plug VFIO Demo\r\n"]
[0.000, "o", "================================================================\r\n\r\n"]
[2.019, "o", "--- 1. Pod is running with kata-coldplug RuntimeClass ---\r\n\u001b[1;32m$ oc get pod kata-dpu-test -o wide\u001b[0m\r\n"]
[1.153, "o", "NAME            READY   STATUS    RESTARTS        AGE   IP            NODE                                           NOMINATED NODE   READINESS GATES\r\nkata-dpu-test   1/1     "]
[0.000, "o", "Running   1 (9m16s ago)   69m   10.130.0.13   wsfd-advnetlab145.anl.eng.bos2.dc.redhat.com   <none>           <none>\r\n"]
[0.014, "o", "\r\n"]
[2.020, "o", "--- 2. Webhook injected DPU NAD automatically ---\r\n"]
[0.000, "o", "\u001b[1;32m$ oc get pod kata-dpu-test -o jsonpath='{.metadata.annotations.v1\\.multus-cni\\.io/default-network}'\u001b[0m\r\n"]
[0.811, "o", "openshift-ovn-kubernetes/dpf-ovn-kubernetes-kata-coldplug"]
[0.015, "o", "\r\n\r\n"]
[2.022, "o", "--- 3. OVN assigned IP and MAC ---\r\n"]
[0.000, "o", "\u001b[1;32m$ oc get pod kata-dpu-test -o jsonpath='{.metadata.annotations.k8s\\.ovn\\.org/pod-networks}' | python3 -m json.tool\u001b[0m\r\n"]
[0.807, "o", "{\r\n    \u001b[1m\"default\"\u001b[0m: {\r\n        \u001b[1m\"ip_addresses\"\u001b[0m: [\r\n            \u001b[32m\"10.130.0.13/23\"\u001b[0m\r\n        ],\r\n        \u001b[1m\"mac_address\"\u001b[0m: \u001b[32m\"0a:58:0a:82:00:0d\"\u001b[0m,\r\n        \u001b[1m\"gateway_ips\"\u001b[0m: [\r\n            \u001b[32m\"10.130.0.1\"\u001b[0m\r\n        ],\r\n        \u001b[1m\"routes\"\u001b[0m: [\r\n            {\r\n                \u001b[1m\"dest\"\u001b[0m: \u001b[32m\"10.128.0.0/14\"\u001b[0m,\r\n                \u001b[1m\"nextHop\"\u001b[0m: \u001b[32m\"10.130.0.1\"\u001b[0m\r\n            },\r\n            {\r\n                \u001b[1m\"dest\"\u001b[0m: \u001b[32m\"172.30.0.0/16\"\u001b[0m,\r\n                \u001b[1m\"nextHop\"\u001b[0m: \u001b[32m\"10.130.0.1\"\u001b[0m\r\n            },\r\n            {\r\n                \u001b[1m\"dest\"\u001b[0m: \u001b[32m\"169.254.0.5/32\"\u001b[0m,\r\n                \u001b[1m\"nextHop\"\u001b[0m: \u001b[32m\"10.130.0.1\"\u001b[0m\r\n            },\r\n            {\r\n                \u001b[1m\"dest\"\u001b[0m: \u001b[32m\"100.64.0.0/16\"\u001b[0m,\r\n                \u001b[1m\"nextHop\"\u001b[0m: \u001b[32m\"10.130.0.1\"\u001b[0m\r\n            }\r\n        ],\r\n        \u001b[1m\"ip_address\"\u001b[0m: \u001b[32m\"10.130.0.13/23\"\u001b[0m,\r\n        \u001b[1m\"gateway_ip\"\u001b[0m: \u001b[32m\"10.130.0.1\"\u001b[0m,\r\n        \u001b[1m\"role\"\u001b[0"]
[0.000, "o", "m: \u001b[32m\"primary\"\u001b[0m\r\n    }\r\n}\r\n"]
[0.009, "o", "\r\n"]
[2.809, "o", "--- 4. QEMU runs with VFIO-passthrough BlueField VF ---\r\n\u001b[1;32m$ oc debug node/$NODE -- chroot /host ps aux | grep vfio-pci\u001b[0m\r\n"]
[2.009, "o", "vfio-pci,host=0000:b2:06.7,id=vfio-8542fe5cb0d4702b0,x-pci-vendor-id=0x15b3,x-pci-device-id=0x101e,bus=rp0\r\nvfio-pci,host=[^\r\n"]
[0.187, "o", "\r\n"]
[2.024, "o", "--- 5. VF bound to vfio-pci with IOMMU on host ---\r\n"]
[3.043, "o", "\u001b[1;32m$ oc debug node/$NODE -- chroot /host cat /sys/bus/pci/devices/0000:b2:06.7/{driver,iommu_group}\u001b[0m\r\n"]
[2.762, "o", "PCI: 0000:b2:06.7\r\nDriver: vfio-pci\r\nIOMMU: group 255\r\n"]
[0.181, "o", "\r\n"]
[2.017, "o", "--- 6. Inside the VM: eth0 MAC matches OVN assignment ---\r\n"]
[0.000, "o", "\u001b[1;32m$ oc exec kata-dpu-test -- cat /sys/class/net/eth0/address\u001b[0m\r\n"]
[1.309, "o", "0a:58:0a:82:00:0d\r\n"]
[0.020, "o", "\r\n"]
[2.020, "o", "--- 7. VM network interface: 100 GbE BlueField VF ---\r\n"]
[0.001, "o", "\u001b[1;32m$ oc exec kata-dpu-test -- bash -c 'for f in rx_packets tx_packets rx_bytes tx_bytes; do printf \"  %-12s %s\r\n\" \"$f:\" \"$(cat /sys/class/net/eth0/statistics/$f)\"; done; echo \"  operstate:   $(cat /sys/class/net/eth0/operstate)\"; echo \"  speed:       $(cat /sys/class/net/eth0/speed) Mbps\"; echo \"  mtu:         $(cat /sys/class/net/eth0/mtu)\"'\u001b[0m\r\n"]
[1.340, "o", "  rx_packets:  187\r\n"]
[0.003, "o", "  tx_packets:  46\r\n"]
[0.006, "o", "  rx_bytes:    61080\r\n"]
[0.003, "o", "  tx_bytes:    3638\r\n"]
[0.013, "o", "  operstate:   up\r\n"]
[0.002, "o", "  speed:       100000 Mbps\r\n"]
[0.001, "o", "  mtu:         1400\r\n"]
[0.025, "o", "\r\n"]
[2.022, "o", "--- 8. mlx5 driver loaded in guest VM ---\r\n"]
[0.000, "o", "\u001b[1;32m$ oc exec kata-dpu-test -- cat /proc/modules | grep mlx5\u001b[0m\r\n"]
[1.519, "o", "mlx5_ib 557056 0 - Live 0x0000000000000000\r\nib_uverbs 221184 1 mlx5_ib, Live 0x0000000000000000\r\nib_core 577536 3 ib_umad,mlx5_ib,ib_uverbs, Live 0x0000000000000000\r\nmacsec 73728 1 mlx5_ib, Live 0x0000000000000000\r\n"]
[0.000, "o", "mlx5_core 3100672 1 mlx5_ib, Live 0x0000000000000000\r\nmlxfw 49152 1 mlx5_core, Live 0x0000000000000000\r\npci_hyperv_intf 12288 1 mlx5_core, Live 0x0000000000000000\r\npsample 20480 1 mlx5_core, Live 0x0000000000000000\r\ntls 159744 1 mlx5_core, Live 0x0000000000000000\r\n"]
[0.016, "o", "\r\n"]
[2.022, "o", "--- 9. ARP to gateway resolves (L2 connectivity) ---\r\n"]
[0.000, "o", "\u001b[1;32m$ oc exec kata-dpu-test -- cat /proc/net/arp\u001b[0m\r\n"]
[1.340, "o", "IP address       HW type     Flags       HW address            Mask     Device\r\n10.130.0.1       0x1         0x2         0a:58:0a:82:00:01     *        eth0\r\n"]
[0.014, "o", "\r\n"]
[2.019, "o", "--- 10. VF representor active on DPU (traffic path) ---\r\n"]
[1.781, "o", "\u001b[1;32m$ KUBECONFIG=$DOCA_KUBECONFIG oc exec $DPU_OVN -c ovn-controller -- ovs-vsctl list interface pf1vf6\u001b[0m\r\n"]
[1.493, "o", "external_ids        : {attached_mac=\"0a:58:0a:82:00:0d\", iface-id=default_kata-dpu-test, iface-id-ver=\"95191381-85c5-49f4-9efa-3dfcdf9d7cda\", ip_addresses=\"10.130.0.13/23\", ovn-installed=\"true\", ovn-installed-ts=\"1786710403371\", sandbox=a9b53b5375f4659297a94451b5fed27f06aace7bdbb1f06216c2579691d2c68a, vf-netdev-name=pf1vf6}\r\nlink_state          : up\r\nname                : pf1vf6\r\nstatus              : {bus_info=\"bus_name=pci, vendor_id=15b3, device_id=a2dc\", dpdk-vf-mac=\"e6:b7:d7:60:49:c5\", driver_name=mlx5_pci, driver_version=\"DPDK 26.03.0-doca4\", if_descr=\"DPDK 26.03.0-doca4 mlx5_pci\", if_type=\"6\", link_speed=\"100Gbps\", max_hash_mac_addrs=\"0\", max_mac_addrs=\"128\", max_rx_pktlen=\"9234\", max_rx_queues=\"1024\", max_tx_queues=\"1024\", max_vfs=\"0\", max_vmdq_pools=\"0\", min_rx_bufsize=\"32\", n_rxq=\"1\", n_txq=\"2\", numa_id=\"-1\", port_no=\"14\", rx-steering=rss, rx_csum_offload=\"true\", tx_geneve_tso_offload=\"false\", tx_ip_csum_offload=\"true\", tx_out_ip_csum_offload=\"true\", tx_out_udp_csum_offload=\"false\", tx_sctp_csum_off"]
[0.000, "o", "load=\"false\", tx_tcp_csum_offload=\"true\", tx_tcp_seg_offload=\"false\", tx_udp_csum_offload=\"true\", tx_vxlan_tso_offload=\"false\"}\r\n"]
[0.019, "o", "\r\n"]
[2.021, "o", "--- 11. Host has NO access to VF (VFIO isolation) ---\r\n"]
[0.000, "o", "\u001b[1;32m$ oc debug node/$NODE -- chroot /host ls /sys/bus/pci/devices/0000:b2:06.7/net/\u001b[0m\r\n"]
[1.571, "o", "To use host binaries, run `chroot /host`. Instead, if you need to access host namespaces, run `nsenter -a -t 1`.\r\n"]
[1.279, "o", "Driver: vfio-pci\r\nls: cannot access '/sys/bus/pci/devices/0000:b2:06.7/net/': No such file or directory\r\n(empty -- VF is inside the VM, not on host)\r\n"]
[0.002, "o", "\r\n"]
[0.177, "o", "\r\n"]
[2.020, "o", "================================================================\r\n  Kata VM running with cold-plugged BlueField-3 100GbE VF\r\n"]
[0.000, "o", "  VFIO passthrough + IOMMU isolation + L2 connectivity\r\n================================================================\r\n"]
